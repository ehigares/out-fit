# Copy this file to .env and fill in your project values.
# NEVER commit .env to version control.

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# ── Stripe ──────────────────────────────────────────────────────────────────
# Secret key — keep server-side only; never expose to the Flutter client.
# Test mode: sk_test_…   Live mode: sk_live_…
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Webhook signing secret — obtained from the Stripe Dashboard after registering
# the stripe_webhook edge function URL as a webhook endpoint.
# Stripe CLI (local testing): stripe listen --forward-to <url>
# The CLI prints the signing secret on start; use that value here.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
